{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutritrack-fdc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "vars": {
    "FIREBASE_PROJECT_ID": "nutrinotrack",
    "ALLOWED_ORIGINS": "http://127.0.0.1:8080,http://localhost:8080,https://nutrinotrack.web.app,https://nutrinotrack.firebaseapp.com"
  },
  "ratelimits": [
    {
      "name": "FDC_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}